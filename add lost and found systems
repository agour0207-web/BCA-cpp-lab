
#include <iostream>
#include <fstream>
#include <sstream>
#include <string>
#include <limits>
#include <cctype>
using namespace std;

const int MAX_RECORDS = 500;
const string DATA_FILE = "lost_found_records.txt";
const string REPORT_FILE = "LostFoundReport.txt";

// Structure to store the details of each lost or found item
struct Item {
    int id;
    string studentId;
    string studentName;
    string itemName;
    string category;
    string location;
    string date;
    string status;
    bool active;
};

// Global array and counters
Item records[MAX_RECORDS];
int recordCount = 0;
int nextRecordId = 1;

string currentStudentId;
string currentStudentName;

// Read a complete line from the user
string readText(string message) {
    string value;
    cout << message;
    getline(cin, value);
    return value;
}

// Read and validate an integer
int readNumber(string message) {
    int number;
    string line;

    while (true) {
        cout << message;
        getline(cin, line);
        stringstream input(line);
        char extra;

        if (input >> number && !(input >> extra))
            return number;

        cout << "Invalid input. Please enter a number.\n";
    }
}

// Prevent the file delimiter from appearing inside text fields
string cleanText(string text) {
    for (int i = 0; i < (int)text.length(); i++) {
        if (text[i] == '|')
            text[i] = '/';
    }
    return text;
}

// Convert text to lowercase for searching and matching
string toLowerCase(string text) {
    for (int i = 0; i < (int)text.length(); i++) {
        text[i] = (char)tolower((unsigned char)text[i]);
    }
    return text;
}

// Load records from the data file
void loadRecords() {
    ifstream file(DATA_FILE.c_str());

    if (!file)
        return;

    string line;

    // First line stores the next record ID
    if (getline(file, line)) {
        stringstream header(line);
        string label;
        int savedId;

        if (getline(header, label, '|') &&
            label == "NEXT" && header >> savedId &&
            savedId > 0) {
            nextRecordId = savedId;
        }
    }

    while (getline(file, line)) {
        if (recordCount >= MAX_RECORDS)
            break;

        string fields[9];
        stringstream row(line);
        bool valid = true;

        for (int i = 0; i < 9; i++) {
            if (!getline(row, fields[i], '|')) {
                valid = false;
                break;
            }
        }

        if (!valid)
            continue;

        stringstream idInput(fields[0]);
        stringstream activeInput(fields[8]);
        Item item;
        int activeValue;

        if (!(idInput >> item.id) ||
            !(activeInput >> activeValue))
            continue;

        if (item.id <= 0 ||
            (activeValue != 0 && activeValue != 1))
            continue;

        item.studentId = fields[1];
        item.studentName = fields[2];
        item.itemName = fields[3];
        item.category = fields[4];
        item.location = fields[5];
        item.date = fields[6];
        item.status = fields[7];
        item.active = (activeValue == 1);

        if (item.status != "Lost" && item.status != "Found")
            continue;

        records[recordCount++] = item;

        if (item.id >= nextRecordId)
            nextRecordId = item.id + 1;
    }

    file.close();
}

// Save records so they remain available after restarting
void saveRecords() {
    ofstream file(DATA_FILE.c_str());

    if (!file) {
        cout << "Error: Unable to save records.\n";
        return;
    }

    file << "NEXT|" << nextRecordId << "\n";

    for (int i = 0; i < recordCount; i++) {
        file << records[i].id << "|"
             << records[i].studentId << "|"
             << records[i].studentName << "|"
             << records[i].itemName << "|"
             << records[i].category << "|"
             << records[i].location << "|"
             << records[i].date << "|"
             << records[i].status << "|"
             << (records[i].active ? 1 : 0) << "\n";
    }

    file.close();
}

// Module 1: Student Login
void studentLogin() {
    cout << "\n--- Student Login ---\n";

    string id = readText("Enter student ID: ");
    string name = readText("Enter student name: ");

    if (id.empty() || name.empty()) {
        cout << "Student ID and name cannot be empty.\n";
        return;
    }

    currentStudentId = cleanText(id);
    currentStudentName = cleanText(name);

    cout << "Welcome, " << currentStudentName << "!\n";
    cout << "Student ID: " << currentStudentId << "\n";
}

// Module 2 and 3: Report Lost or Found Item
void reportItem(string itemStatus) {
    if (currentStudentId.empty()) {
        cout << "Please log in first.\n";
        return;
    }

    if (recordCount >= MAX_RECORDS) {
        cout << "Maximum record capacity reached.\n";
        return;
    }

    Item newItem;

    newItem.id = nextRecordId++;
    newItem.studentId = currentStudentId;
    newItem.studentName = currentStudentName;
    newItem.status = itemStatus;
    newItem.active = true;

    newItem.itemName = cleanText(
        readText("Enter item name: "));
    newItem.category = cleanText(
        readText("Enter category: "));
    newItem.location = cleanText(
        readText("Enter location: "));
    newItem.date = cleanText(
        readText("Enter date (DD-MM-YYYY): "));

    if (newItem.itemName.empty() ||
        newItem.category.empty() ||
        newItem.location.empty() ||
        newItem.date.empty()) {
        cout << "All item fields are required. Record not saved.\n";
        nextRecordId--;
        return;
    }

    records[recordCount++] = newItem;
    saveRecords();

    cout << itemStatus << " item reported successfully.\n";
    cout << "Record ID: " << newItem.id << "\n";
}

// Display one record
void displayItem(const Item &item) {
    cout << "\nRecord ID: " << item.id
         << "\nStatus: " << item.status
         << "\nItem: " << item.itemName
         << "\nCategory: " << item.category
         << "\nLocation: " << item.location
         << "\nDate: " << item.date
         << "\nStudent: " << item.studentName
         << "\nStudent ID: " << item.studentId
         << "\n-----------------------------\n";
}

// Module 4: Search records by item, category, or location
void searchItem() {
    string keyword = readText(
        "Enter item name, category, or location: ");

    keyword = toLowerCase(keyword);
    bool found = false;

    for (int i = 0; i < recordCount; i++) {
        if (!records[i].active)
            continue;

        if (toLowerCase(records[i].itemName).find(keyword)
                != string::npos ||
            toLowerCase(records[i].category).find(keyword)
                != string::npos ||
            toLowerCase(records[i].location).find(keyword)
                != string::npos) {
            displayItem(records[i]);
            found = true;
        }
    }

    if (!found)
        cout << "No matching records found.\n";
}

// Module 5: Automatically find possible Lost and Found matches
void autoMatch() {
    bool matchFound = false;

    for (int i = 0; i < recordCount; i++) {
        if (!records[i].active ||
            records[i].status != "Lost")
            continue;

        for (int j = 0; j < recordCount; j++) {
            if (!records[j].active ||
                records[j].status != "Found")
                continue;

            bool sameName =
                toLowerCase(records[i].itemName) ==
                toLowerCase(records[j].itemName);

            bool sameCategory =
                toLowerCase(records[i].category) ==
                toLowerCase(records[j].category);

            if (sameName && sameCategory) {
                cout << "\nPossible match found!\n";
                cout << "Lost Record ID: "
                     << records[i].id << "\n";
                cout << "Found Record ID: "
                     << records[j].id << "\n";
                cout << "Item: "
                     << records[i].itemName << "\n";
                cout << "Lost location: "
                     << records[i].location << "\n";
                cout << "Found location: "
                     << records[j].location << "\n";

                matchFound = true;
            }
        }
    }

    if (!matchFound)
        cout << "No possible matches found.\n";

    cout << "Matches are suggestions. Verify ownership "
         << "with college staff.\n";
}

// Module 6: View records in alphabetical order
// Bubble sort is applied to an array of record indexes.
void viewAllRecords() {
    int order[MAX_RECORDS];
    int activeCount = 0;

    for (int i = 0; i < recordCount; i++) {
        if (records[i].active)
            order[activeCount++] = i;
    }

    // Sort record indexes by item name
    for (int i = 0; i < activeCount - 1; i++) {
        for (int j = 0; j < activeCount - i - 1; j++) {
            if (toLowerCase(records[order[j]].itemName) >
                toLowerCase(records[order[j + 1]].itemName)) {
                int temp = order[j];
                order[j] = order[j + 1];
                order[j + 1] = temp;
            }
        }
    }

    if (activeCount == 0) {
        cout << "No active records available.\n";
        return;
    }

    cout << "\n--- All Records (Sorted by Item Name) ---\n";

    for (int i = 0; i < activeCount; i++)
        displayItem(records[order[i]]);
}

// Module 7: Delete a record belonging to the logged-in student
void deleteRecord() {
    if (currentStudentId.empty()) {
        cout << "Please log in first.\n";
        return;
    }

    int id = readNumber("Enter record ID to delete: ");

    for (int i = 0; i < recordCount; i++) {
        if (records[i].active && records[i].id == id) {
            if (records[i].studentId != currentStudentId) {
                cout << "You can delete only your own records.\n";
                return;
            }

            records[i].active = false;
            saveRecords();

            cout << "Record deleted successfully.\n";
            return;
        }
    }

    cout << "Active record not found.\n";
}

// Module 8: Count lost and found records
void itemStatistics() {
    int lostCount = 0;
    int foundCount = 0;

    for (int i = 0; i < recordCount; i++) {
        if (!records[i].active)
            continue;

        if (records[i].status == "Lost")
            lostCount++;
        else if (records[i].status == "Found")
            foundCount++;
    }

    cout << "\n--- Item Statistics ---\n";
    cout << "Lost items: " << lostCount << "\n";
    cout << "Found items: " << foundCount << "\n";
    cout << "Total active records: "
         << lostCount + foundCount << "\n";
}

// Module 9: Export active records to a separate report
void exportReport() {
    ofstream file(REPORT_FILE.c_str());

    if (!file) {
        cout << "Unable to create report file.\n";
        return;
    }

    file << "COLLEGE LOST AND FOUND REPORT\n";
    file << "============================\n\n";

    int exportedCount = 0;

    for (int i = 0; i < recordCount; i++) {
        if (!records[i].active)
            continue;

        file << "Record ID: " << records[i].id << "\n"
             << "Status: " << records[i].status << "\n"
             << "Item: " << records[i].itemName << "\n"
             << "Category: " << records[i].category << "\n"
             << "Location: " << records[i].location << "\n"
             << "Date: " << records[i].date << "\n"
             << "Student: " << records[i].studentName << "\n"
             << "Student ID: " << records[i].studentId << "\n"
             << "----------------------------\n";

        exportedCount++;
    }

    file << "\nTotal active records: " << exportedCount << "\n";
    file.close();

    cout << "Report exported successfully to "
         << REPORT_FILE << "\n";
}

// Main function: menu-driven application
int main() {
    loadRecords();

    cout << "====================================\n";
    cout << " COLLEGE LOST & FOUND MANAGEMENT\n";
    cout << "====================================\n";

    studentLogin();

    int choice;

    do {
        cout << "\n========== MAIN MENU ==========\n";
        cout << "1. Student Login / Change Student\n";
        cout << "2. Report Lost Item\n";
        cout << "3. Report Found Item\n";
        cout << "4. Search Item\n";
        cout << "5. Auto Match Lost & Found\n";
        cout << "6. View All Records (Sorted)\n";
        cout << "7. Delete Record\n";
        cout << "8. Item Statistics\n";
        cout << "9. Export Report\n";
        cout << "10. Exit\n";

        choice = readNumber("Enter your choice: ");

        switch (choice) {
            case 1:
                studentLogin();
                break;

            case 2:
                reportItem("Lost");
                break;

            case 3:
                reportItem("Found");
                break;

            case 4:
                searchItem();
                break;

            case 5:
                autoMatch();
                break;

            case 6:
                viewAllRecords();
                break;

            case 7:
                deleteRecord();
                break;

            case 8:
                itemStatistics();
                break;

            case 9:
                exportReport();
                break;

            case 10:
                cout << "Thank you for using the system!\n";
                break;

            default:
                cout << "Invalid choice. Enter 1 to 10.\n";
        }

    } while (choice != 10);

    return 0;
}
